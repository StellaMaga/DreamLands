  m_Name: Spider
  m_EditorClassIdentifier: Assembly-CSharp::TextGame.Core.EnemyData
  enemyId: Leng_Spider
  enemyName: "\uB81D\uC758 \uAC70\uBBF8"
  detection: 50
  maxHp: 3
  damage: 7
  gimmick: {fileID: 0}
  encounterText: "\uBCF4\uB77C\uC0C9 \uD138\uB85C \uB4A4\uB36E\uC778 \uAC70\uB300\uD55C
    \uB2E4\uB9AC \uC5EC\uB35F \uAC1C\uAC00 \uC18C\uB9AC \uC5C6\uC774 \uAE30\uC5B4
    \uB098\uC628\uB2E4.\r\n\uC778\uAC04\uC758 \uC5BC\uAD74\uC744 \uB2EE\uC740 \uD749\uCE21\uD55C
    \uD131\uC774 \uC798\uAC01\uAC70\uB9AC\uBA70 \uCE68\uC744 \uD758\uB9BD\uB2C8\uB2E4."
  ambushText: "\uB81D\uC758 \uAC70\uBBF8\uAC00 \uCC9C\uC7A5\uC5D0\uC11C \uB048\uC801\uD55C
    \uAC70\uBBF8\uC904\uC744 \uBFDC\uC5B4\uB0B4\uBA70 \uAE30\uC2B5\uD574 \uC635\uB2C8\uB2E4!"
  attackText: "\uAC70\uBBF8\uC758 \uB0A0\uCE74\uB85C\uC6B4 \uB3C5\uB2C8\uAC00 \uB2F9\uC2E0\uC758
    \uC815\uC2E0 \uBC29\uBCBD\uC744 \uD30C\uACE0\uB4ED\uB2C8\uB2E4."
  hitText: "\uAFC8\uC758 \uAC04\uC12D\uC774 \uC801\uC911\uD558\uC790 \uB81D\uC758
    \uAC70\uBBF8\uAC00 \uBD88\uCF8C\uD55C \uBE44\uBA85\uC744 \uC9C0\uB974\uBA70 \uB2E4\uB9AC\uB97C
    \uBE44\uD2C0\uAC70\uB9BD\uB2C8\uB2E4."
  deathText: "\uB81D\uC758 \uAC70\uBBF8\uB294 \uD749\uCE21\uD55C \uCCB4\uC561\uC744
    \uD769\uBFCC\uB9AC\uBA70 \uAC80\uC740 \uBA3C\uC9C0\uAC00 \uB418\uC5B4 \uD769\uC5B4\uC9D1\uB2C8\uB2E4."
